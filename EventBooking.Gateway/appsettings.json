{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "eventbooking-route": {
        "ClusterId": "eventbooking-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "eventbooking-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:03",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/api/instance"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        },
        "Destinations": {
          "api1": {
            "Address": "http://localhost:5062/"
          },
          "api2": {
            "Address": "http://localhost:5063/"
          }
        }
      }
    }
  }
}
